# THIS .ENV FILE IS FOR TESTING PURPOSES ONLY AND CONTAINS FAKE DATA

# --- System ---
NODE_ENV=test
PORT=4000
APP_TYPE=api

# --- Security & Auth ---
CORS_ORIGIN=*
AUTH0_ISSUER_BASE_URL=https://test
AUTH0_AUDIENCE=https://test
AUTH0_M2M_CLIENT_ID=test
AUTH0_M2M_CLIENT_SECRET=test

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
CLOUDINARY_BASE_FOLDER=test

# --- Logger ---
LOG_LEVEL=debug
LOG_DIR=logs

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=test_user
DB_PASS=test_pass
DB_NAME=test_db
DB_DEFAULT_NAME=postgres
DB_DEBUG=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=test_pass
REDIS_DB=0

# --- Seed Demo Data (Optional for local dev) ---
SEED_ADMIN_AUTH0_ID=auth0|test_admin123
SEED_ADMIN_EMAIL=test.admin@engla.com
SEED_HOST_AUTH0_ID=auth0|test_host123
SEED_HOST_EMAIL=test.host@example.com