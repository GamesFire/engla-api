{
  "name": "engla-api",
  "version": "1.1.0",
  "description": "Production-ready RESTful API for EngLa — a short-term rental marketplace in England. Built with Node.js, Express, TypeScript, PostgreSQL, and Clean Architecture principles.",
  "exports": "./dist/entrypoint.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:api": "APP_TYPE=api nodemon",
    "dev:worker": "APP_TYPE=worker nodemon",
    "dev:all": "concurrently -c \"cyan,magenta\" -n \"API,WORKER\" \"npm run dev:api\" \"npm run dev:worker\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/entrypoint.js",
    "start:api": "APP_TYPE=api node dist/entrypoint.js",
    "start:worker": "APP_TYPE=worker node dist/entrypoint.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "cli": "tsx src/cli/cli.entrypoint.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GamesFire/engla-api.git"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "rest-api",
    "postgresql",
    "clean-architecture",
    "booking-system",
    "marketplace",
    "england",
    "backend"
  ],
  "author": "Lobix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GamesFire/engla-api/issues"
  },
  "homepage": "https://github.com/GamesFire/engla-api#readme",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bugsnag/js": "^8.10.0",
    "@bugsnag/plugin-express": "^9.1.0",
    "auth0": "^7.5.0",
    "bullmq": "^6.3.17",
    "cloudinary": "^2.11.0",
    "commander": "^15.0.0",
    "connection-string": "^5.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.1",
    "express": "^5.3.0",
    "express-jwt": "^8.5.1",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "inversify": "^8.2.3",
    "ioredis": "^6.0.0",
    "jwks-rsa": "^4.1.0",
    "knex": "^3.3.0",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "objection": "^4.2.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.1",
    "stripe": "^22.6.1",
    "ulid": "^3.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.8",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
