# --- System ---
NODE_ENV="development"
PORT=4000
APP_TYPE="api"

# --- Security & Auth ---
CORS_ORIGIN=
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
ROOT_ADMIN_AUTH0_ID="auth0|root_admin123"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=
STRIPE_REFRESH_URL=

# --- Logger ---
LOG_LEVEL="info"
LOG_DIR="logs"

# --- Database ---
DB_HOST="localhost"
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_DEFAULT_NAME=
DB_DEBUG=false

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# --- Cron Jobs ---
CRON_CLEANUP_SCHEDULE="0 2 * * *" # At 02:00 AM
CRON_CLEANUP_DRAFTS_DAYS=30
CRON_CLEANUP_SOFT_DAYS=60
CRON_CLEANUP_HARD_DAYS=365

# --- Seed Demo Data (Optional for local dev) ---
SEED_ADMIN_AUTH0_ID="auth0|admin123"
SEED_ADMIN_EMAIL="admin@engla.com"
SEED_HOST_AUTH0_ID="auth0|host123"
SEED_HOST_EMAIL="demo.host@example.com"